# Chaves PÚBLICAS do Supabase (anon key é publicável por desenho; a proteção
# real é a RLS — ver SECURITY.md). NUNCA colocar a service_role key aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Centro padrão: Niterói/RJ, município de aplicação da Resolução (art. 1º).
# Estilo do mapa (MapLibre). Aceita qualquer style.json vetorial.
# Deixar vazio usa o estilo de fallback OSM raster embutido em src/lib/map.ts.
VITE_MAP_STYLE_URL=
VITE_MAP_CENTER_LNG=-43.1036
VITE_MAP_CENTER_LAT=-22.8832
VITE_MAP_ZOOM=12
