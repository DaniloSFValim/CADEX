{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/anatel/niteroi.json", "destination": "https://netranking-rj.labdados.org/data/municipios/niteroi.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
